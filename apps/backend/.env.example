# Copy to .env and fill in for local dev.

# Local Postgres (see docs/PROJECT_NOTES.md for the `brew install postgresql@16` setup).
# Homebrew's Postgres has no password by default, but still needs an
# explicit username, your macOS username (run `whoami` if unsure), not blank.
DATABASE_URL="postgresql://YOUR_MAC_USERNAME@localhost:5432/kineris"

# Any long random string for local dev; use a real generated secret before deploy.
SESSION_SECRET="dev-only-change-me"

PORT=4000

# CORS: the storefront and admin app origins allowed to call this API.
WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3002"

# Stripe, deferred per the project plan until real keys exist. Leave blank
# locally; checkout runs in a stubbed "test" mode when these are unset.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
